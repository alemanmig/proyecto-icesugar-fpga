# =============================================================================
# Pin Constraint File — Contador Binario con PMOD-LED v1.1
# Chip:  Lattice iCE40LP1K-CM36
# PMOD:  PMOD-LED v1.1 conectado al conector 2x6 de la iCESugar-Nano
# =============================================================================
#
# Mapeo físico PMOD-LED → conector 2x6 → ball CM36:
#
#   PMOD-LED pin  │ Señal  │ Ball CM36
#   ──────────────┼────────┼──────────
#   D0  (LSB)    │ leds[0]│ C6
#   D1            │ leds[1]│ E3
#   D2            │ leds[2]│ C2
#   D3            │ leds[3]│ A1
#   D4            │ leds[4]│ B4
#   D5            │ leds[5]│ B5
#   D6            │ leds[6]│ E1
#   D7  (MSB)    │ leds[7]│ B1
#
# Lectura visual: D7-D6-D5-D4-D3-D2-D1-D0  (izquierda = MSB)
# =============================================================================

# Reloj 12 MHz
set_io clk      D1

# LEDs del PMOD-LED (activo en alto: 1 = encendido)
set_io leds[0]  C6
set_io leds[1]  E3
set_io leds[2]  C2
set_io leds[3]  A1
set_io leds[4]  B4
set_io leds[5]  B5
set_io leds[6]  E1
set_io leds[7]  B1
